{
  "name": "heng",
  "version": "2.0.0",
  "private": true,
  "description": "记仇小本本 - Cloudflare Workers 原生全栈项目 (D1 + R2 + Static Assets)",
  "license": "MIT",
  "author": "ekishion",
  "repository": {
    "type": "git",
    "url": "https://github.com/ekishion/heng.git"
  },
  "scripts": {
    "dev:worker": "wrangler dev",
    "dev:client": "vite",
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "cf:deploy": "vite build && wrangler deploy",
    "release": "vite build && wrangler deploy",
    "db:migrate": "wrangler d1 execute heng --remote --file=./src/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute heng --local --file=./src/db/schema.sql",
    "cf:login": "wrangler login",
    "hash-pwd": "node scripts/hash-pwd.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "hono": "^4.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "wrangler": "^4.147.0"
  }
}
